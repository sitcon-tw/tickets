{
	"name": "sitcontix",
	"version": "1.0.0",
	"license": "Apache-2.0",
	"author": "Nelson & Elvis Mao",
	"scripts": {
		"build:frontend": "pnpm --filter frontend build",
		"check-format": "prettier --check .",
		"dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
		"dev:backend": "pnpm --filter backend dev",
		"dev:frontend": "pnpm --filter frontend dev --port 4322",
		"format": "prettier --write .",
		"postinstall": "pnpm --filter types build",
		"lint": "oxlint --type-aware",
		"prepare": "husky || true",
		"start": "concurrently \"pnpm start:frontend\" \"pnpm start:backend\"",
		"start:backend": "pnpm --filter backend start",
		"start:frontend": "pnpm --filter frontend start --port 4322"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"concurrently": "^10.0.5",
		"husky": "^9.1.7",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2002",
		"prettier": "3.9.8",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.3.4"
}
